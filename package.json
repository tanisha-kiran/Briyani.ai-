{
  "name": "biryani-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-studio.cjs",
    "build": "node scripts/build-renderer.mjs && tsc --noEmit",
    "preview": "vite preview",
    "studio": "node scripts/start-studio.cjs",
    "renderer:build": "node scripts/build-renderer.mjs",
    "test:engine": ".venv/Scripts/python.exe -m pytest tests -q",
    "test:motion": "node --test tests/motion.test.mjs",
    "test:renderer": "node scripts/check-renderer.mjs",
    "test:ui-state": "node --test tests/onboarding.test.cjs"
  },
  "dependencies": {
    "@ffprobe-installer/win32-x64": "^5.1.0",
    "@napi-rs/canvas": "^1.0.13",
    "@resvg/resvg-js": "^2.6.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  }
}
